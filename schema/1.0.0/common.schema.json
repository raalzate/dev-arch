{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://static-inference.dev/schema/1.0.0/common.schema.json",
  "title": "StaticInferenceCommon",
  "description": "Shared definitions of the Static Inference output contract 1.0.0 (describes the real v1.1.0 output plus meta.schema_version).",
  "$defs": {
    "ApiContracts": {
      "title": "ApiContracts",
      "description": "Endpoints and data schemas (output_entrypoints.json, embedded as api_contracts in the graph).",
      "type": "object",
      "properties": {
        "meta": {
          "$ref": "#/$defs/DocumentMeta"
        },
        "endpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ApiEndpoint"
          }
        },
        "schemas": {
          "description": "Dynamic map: schema name -> schema.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ApiSchema"
          }
        }
      },
      "required": [
        "endpoints",
        "schemas"
      ],
      "additionalProperties": false
    },
    "ApiEndpoint": {
      "title": "ApiEndpoint",
      "description": "Entry point exposed by a component.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "method": {
          "type": "string",
          "description": "HTTP verb or non-HTTP kind (STRUTS_ACTION, SOAP, LISTENER, ...); open set."
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Parameter"
          }
        },
        "request_body_schema": {
          "type": [
            "string",
            "null"
          ]
        },
        "response_schema": {
          "type": [
            "string",
            "null"
          ],
          "description": "Name of the response schema; omitted by the .NET analyzer when null."
        },
        "component_id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "path",
        "method",
        "parameters",
        "component_id"
      ],
      "additionalProperties": false
    },
    "ApiSchema": {
      "title": "ApiSchema",
      "description": "Data schema referenced by endpoints.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "properties": {
          "description": "Dynamic map: property name -> property.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ApiSchemaProperty"
          }
        }
      },
      "required": [
        "type",
        "properties"
      ],
      "additionalProperties": false
    },
    "ApiSchemaProperty": {
      "title": "ApiSchemaProperty",
      "description": "Property of a data schema.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "CodeIssue": {
      "title": "CodeIssue",
      "description": "Static code issue detected in a component.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "BUG_PATTERN",
            "CODE_STYLE",
            "SECURITY",
            "PERFORMANCE"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "INFO",
            "WARNING",
            "ERROR",
            "CRITICAL"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 0,
          "description": "Line number (0 when unknown)."
        },
        "pattern": {
          "type": "string",
          "description": "Rule identifier (open set of values).",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "severity",
        "message",
        "line",
        "pattern"
      ],
      "additionalProperties": false
    },
    "Component": {
      "title": "Component",
      "description": "Unit of analysis (class/interface/enum or .NET type).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Fully qualified name.",
          "minLength": 1
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Source files of the component."
        },
        "loc": {
          "type": "integer",
          "minimum": 0,
          "description": "Lines of code."
        },
        "tables_used": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sensitive_data": {
          "type": "boolean"
        },
        "secrets_references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "layer": {
          "description": "Architectural layer. \"Datos\" is the historical alias of \"Persistencia\".",
          "type": "string",
          "enum": [
            "Controlador",
            "Negocio",
            "Datos",
            "Persistencia",
            "Dominio",
            "Transferencia",
            "Web",
            "Compartida"
          ]
        },
        "calls_out": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "calls_in": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "implements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "external_dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "package_dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PackageGroup"
          }
        },
        "code_issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CodeIssue"
          }
        },
        "uses_jndi": {
          "type": "boolean"
        },
        "is_interface": {
          "type": "boolean"
        },
        "interface": {
          "description": "Deprecated duplicate of is_interface (emitted by the Java engine only).",
          "type": "boolean",
          "deprecated": true
        },
        "domain": {
          "type": [
            "string",
            "null"
          ]
        },
        "ejb_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "extends": {
          "type": [
            "string",
            "null"
          ]
        },
        "messaging_type": {
          "type": [
            "string",
            "null"
          ],
          "description": "Open set of values (jms, MassTransit, ...)."
        },
        "messaging_role": {
          "type": [
            "string",
            "null"
          ],
          "description": "Open set of values."
        },
        "web_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "web_role": {
          "type": [
            "string",
            "null"
          ]
        },
        "cbo": {
          "description": "Coupling Between Objects.",
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "lcom": {
          "description": "Lack of Cohesion in Methods (LCOM-HS, 0 = cohesive).",
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "complexity_avg": {
          "description": "Average cyclomatic complexity.",
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "complexity_max": {
          "description": "Maximum cyclomatic complexity.",
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "files",
        "loc",
        "tables_used",
        "sensitive_data",
        "secrets_references",
        "layer",
        "calls_out",
        "calls_in",
        "annotations",
        "implements",
        "external_dependencies",
        "package_dependencies",
        "code_issues",
        "uses_jndi",
        "is_interface"
      ],
      "additionalProperties": false
    },
    "DocumentMeta": {
      "title": "DocumentMeta",
      "description": "Contract metadata of the consolidated architecture and entrypoints documents.",
      "type": "object",
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "schema_version"
      ],
      "additionalProperties": false
    },
    "Edge": {
      "title": "Edge",
      "description": "Dependency between two components.",
      "type": "object",
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "weight": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "description": "Edge kind; open set, composite values are comma separated (e.g. call,use,injection-constructor).",
          "pattern": "^[a-z][a-z-]*(,[a-z][a-z-]*)*$"
        }
      },
      "required": [
        "from",
        "to",
        "weight",
        "type"
      ],
      "additionalProperties": false
    },
    "GraphMeta": {
      "title": "GraphMeta",
      "description": "Metadata of the dependency graph.",
      "type": "object",
      "properties": {
        "source": {
          "description": "Producer of the graph: Java (Spoon) or .NET (Roslyn, or Roslyn adhoc fallback with reduced fidelity).",
          "type": "string",
          "enum": [
            "spoon",
            "roslyn",
            "roslyn-fallback"
          ]
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "collected_at": {
          "description": "Collection timestamp (ISO 8601), only when STATIC_INFERENCE_COLLECTED_AT is enabled.",
          "type": "string",
          "format": "date-time"
        },
        "microservice_candidates": {
          "description": "Dynamic map: component id -> candidate cluster name.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "dependency_accuracy": {
          "description": "Optional accuracy report (reserved).",
          "type": [
            "object",
            "null"
          ]
        },
        "decomposition_accuracy": {
          "description": "Optional accuracy report (reserved).",
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "source",
        "schema_version",
        "microservice_candidates"
      ],
      "additionalProperties": false
    },
    "LegacyEntrypoint": {
      "title": "LegacyEntrypoint",
      "description": "How the legacy system enters the proposal (null members are omitted).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "rest",
            "messaging",
            "service",
            "internal"
          ]
        },
        "primary_entry_class": {
          "type": "string"
        },
        "exposed_operations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "messaging_channels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "endpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ApiEndpoint"
          }
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "PackageDependencyInfo": {
      "title": "PackageDependencyInfo",
      "description": "Aggregated dependencies of a package.",
      "type": "object",
      "properties": {
        "components_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_dependencies_out": {
          "type": "integer",
          "minimum": 0
        },
        "depends_on_packages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "components_count",
        "total_dependencies_out",
        "depends_on_packages"
      ],
      "additionalProperties": false
    },
    "PackageGroup": {
      "title": "PackageGroup",
      "description": "Internal package a component depends on.",
      "type": "object",
      "properties": {
        "package_name": {
          "type": "string"
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "package_name",
        "components",
        "count"
      ],
      "additionalProperties": false
    },
    "Parameter": {
      "title": "Parameter",
      "description": "Endpoint parameter.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "in": {
          "type": "string",
          "description": "path, query, header, body (open set)."
        },
        "type": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "in",
        "type",
        "required"
      ],
      "additionalProperties": false
    },
    "ProjectMetadata": {
      "title": "ProjectMetadata",
      "description": "Project-level metadata (null members are omitted).",
      "type": "object",
      "properties": {
        "external_dependencies": {
          "description": "Dynamic map: dependency key -> coordinates.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "package_dependencies": {
          "description": "Dynamic map: package -> aggregated dependencies.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/PackageDependencyInfo"
          }
        },
        "total_components": {
          "type": "integer",
          "minimum": 0
        },
        "total_loc": {
          "type": "integer",
          "minimum": 0
        },
        "components_with_secrets": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of components referencing secrets."
        },
        "shared_domain": {
          "type": "string"
        },
        "secrets_locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SecretLocation"
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "Proposal": {
      "title": "Proposal",
      "description": "Microservice extraction proposal.",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "viability": {
          "type": "string",
          "enum": [
            "Alta",
            "Media",
            "Baja"
          ]
        },
        "clusters": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metrics": {
          "$ref": "#/$defs/ProposalMetrics"
        },
        "signals": {
          "$ref": "#/$defs/ProposalSignals"
        },
        "rationale": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recommended_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProposalTable"
          }
        },
        "legacy_entrypoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/LegacyEntrypoint"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "viability",
        "clusters",
        "components",
        "metrics",
        "signals",
        "rationale",
        "recommended_actions"
      ],
      "additionalProperties": false
    },
    "ProposalMetrics": {
      "title": "ProposalMetrics",
      "description": "Metrics of a microservice proposal.",
      "type": "object",
      "properties": {
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "cohesion_avg": {
          "type": "number"
        },
        "external_coupling": {
          "type": "number"
        },
        "internal_edge_density": {
          "type": "number"
        },
        "data_jaccard": {
          "type": "number"
        },
        "tables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sensitive": {
          "type": "boolean"
        },
        "tables_source": {
          "type": "string",
          "description": "Open set (jpa, orm, sql-parse, mixed, none)."
        }
      },
      "required": [
        "size",
        "cohesion_avg",
        "external_coupling",
        "internal_edge_density",
        "data_jaccard",
        "tables",
        "sensitive"
      ],
      "additionalProperties": false
    },
    "ProposalSignals": {
      "title": "ProposalSignals",
      "description": "Clustering signals of a proposal.",
      "type": "object",
      "properties": {
        "avg_cluster_size": {
          "type": "number"
        },
        "cluster_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_components": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "avg_cluster_size",
        "cluster_count",
        "total_components"
      ],
      "additionalProperties": false
    },
    "ProposalTable": {
      "title": "ProposalTable",
      "description": "Table used by a proposal.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "component": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "component",
        "source"
      ],
      "additionalProperties": false
    },
    "SchemaVersion": {
      "title": "SchemaVersion",
      "description": "Semantic version of the output contract. Contract 1.0.0 only accepts \"1.0.0\".",
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "const": "1.0.0"
    },
    "SecretLocation": {
      "title": "SecretLocation",
      "description": "Location of a (redacted) secret.",
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "type": "string",
          "description": "Open set (API_KEY, JDBC_PASSWORD, ...)."
        },
        "redacted": {
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "line",
        "kind",
        "redacted"
      ],
      "additionalProperties": false
    },
    "SupportLibrary": {
      "title": "SupportLibrary",
      "description": "Shared library candidate.",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "clusters": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "name",
        "clusters",
        "components"
      ],
      "additionalProperties": false
    }
  }
}
