{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://static-inference.dev/schema/1.0.0/dependency-graph.schema.json",
  "title": "DependencyGraph",
  "description": "Dependency graph (output.json; MCP get_dependency_graph). api_contracts.meta is optional (the raw .NET graph does not emit it).",
  "type": "object",
  "properties": {
    "components": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Component"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Edge"
      }
    },
    "api_contracts": {
      "$ref": "common.schema.json#/$defs/ApiContracts"
    },
    "meta": {
      "$ref": "common.schema.json#/$defs/GraphMeta"
    }
  },
  "required": [
    "components",
    "edges",
    "api_contracts",
    "meta"
  ],
  "additionalProperties": false
}
