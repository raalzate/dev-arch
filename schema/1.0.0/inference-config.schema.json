{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://static-inference.dev/schema/1.0.0/inference-config.schema.json",
  "title": "InferenceConfig",
  "description": "Inference configuration (008-configurable-inference): analysis-config.json, CLI --config, MCP config/configPath. Every property is optional; omitted properties keep the defaults (MCP resource static-inference://configuration/defaults). Range checks between properties (medium <= high, fair/good cuts) are enforced by the engine.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxDepth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "clustering": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "singleDomainRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "largeClusterRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "attachCallersToTargets": {
          "type": "boolean",
          "description": "023: in the entity path, a component without procedures joins the cluster it calls most."
        },
        "procedureGrouping": {
          "enum": [
            "transitive",
            "entity"
          ],
          "description": "023: transitive = components sharing procedures (transitively) form one cluster; entity = components grouped by the stem of their dominant procedure entity."
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "weights": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "table": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "call": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "token": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "event": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "edgeThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "callDensitySaturation": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "strongSignals": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "table": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "call": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "token": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "evidenceThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minStrongSignals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "roleKeywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^A-Z]*$"
          }
        },
        "excludeTokens": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "minPackageTokenLength": {
          "type": "integer",
          "minimum": 0
        },
        "eventPublisherKeywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^A-Z]*$"
          }
        },
        "eventConsumerKeywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^A-Z]*$"
          }
        }
      }
    },
    "consolidation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "genericNames": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "domainMergeMaxSize": {
          "type": "integer",
          "minimum": 0
        },
        "significantInfrastructureRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "supportRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maxMergedSizeWithoutSimilarity": {
          "type": "integer",
          "minimum": 0
        },
        "highTokenSimilarity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "separationCallDensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "separationTableJaccard": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "strongCandidate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minCohesion": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "maxCoupling": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minSize": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "infrastructureKeywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^A-Z]*$"
          }
        },
        "verticalSliceRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "023: share of a cluster's outgoing cross-cluster calls (support clusters excluded) that must target one other cluster to merge both as a vertical slice; 0 disables the rule."
        },
        "entityStemMerge": {
          "type": "boolean",
          "description": "023: merge clusters whose dominant procedure entities share a stem."
        }
      }
    },
    "viability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "weights": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cohesion": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "coupling": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "data": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "cohesionBlend": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "average": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "density": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "noTablesDataCohesion": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "smallSize": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "below": {
              "type": "integer",
              "minimum": 0
            },
            "penalty": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "largeSize": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "above": {
              "type": "integer",
              "minimum": 0
            },
            "minDensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "penalty": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "high": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "medium": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "rationale": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cohesionGood": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "cohesionFair": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "couplingGood": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "couplingFair": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "cboGood": {
              "type": "number",
              "minimum": 0
            },
            "cboFair": {
              "type": "number",
              "minimum": 0
            },
            "lcomGood": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "lcomFair": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "dataGood": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "dataFair": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "debtWeight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "023: weight of the debt index subtracted from the viability score; 0 keeps the 1.2.0 score."
        },
        "ignoreSupportCoupling": {
          "type": "boolean",
          "description": "023: calls to support-library members do not count as external coupling."
        },
        "maintainabilityWeight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "024: weight of (1 - MI/100) added to the debt index when the component carries Maintainability:<n>."
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "supportRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "infrastructureKeywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^A-Z]*$"
          }
        },
        "dataJaccardMode": {
          "enum": [
            "legacy",
            "data_cohesion"
          ]
        },
        "legacyDataJaccard": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "supportNamespaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "023: namespace segments whose components form support libraries."
        },
        "minReferencingDomains": {
          "type": "integer",
          "minimum": 0,
          "description": "023: distinct calling domains from which a group is a shared support library; 0 disables the rule."
        }
      }
    },
    "naming": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "infrastructureRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "infrastructureLabels": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[^A-Z]+$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "roleKeywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^A-Z]*$"
          }
        },
        "excludeTokens": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "minTokenLength": {
          "type": "integer",
          "minimum": 0
        },
        "strategy": {
          "enum": [
            "tokens",
            "domain"
          ],
          "description": "023: tokens = 1.2.0 names; domain = namespace domain shared by the members."
        }
      }
    },
    "dataAccess": {
      "type": "object",
      "additionalProperties": false,
      "description": "Data access parameters (020-stored-procedures): stored procedure detection in the .NET analyzer, the optional procedure catalog and the weight of sp: resources in the inference.",
      "properties": {
        "procedures": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "description": "Stored procedure detection: auto = Visual Basic compilations only."
        },
        "procedureCatalog": {
          "type": [
            "string",
            "null"
          ],
          "description": "Directory of .sql scripts (CREATE PROCEDURE) or .csv file (procedimiento,tabla,operación) translating procedures to tables."
        },
        "catalogMode": {
          "type": "string",
          "enum": [
            "complement",
            "replace"
          ],
          "description": "complement keeps sp:<name> next to the tables; replace emits tables only."
        },
        "procedureWeight": {
          "type": "number",
          "minimum": 0,
          "description": "Weight of an sp: resource relative to a table in shared-data grouping, tables_shared and data cohesion; 0 ignores procedures."
        },
        "entityHeuristic": {
          "type": "boolean",
          "description": "Derive a business entity from procedure names for proposal naming."
        }
      }
    },
    "debt": {
      "type": "object",
      "additionalProperties": false,
      "description": "Legacy debt rules of the .NET analyzer (021-desktop-identity-layers).",
      "properties": {
        "enabled": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "description": "auto = Visual Basic compilations only."
        },
        "godClass": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minLoc": {
              "type": "integer",
              "minimum": 1,
              "description": "Lines of code above which a type may be a god class."
            },
            "minComplexity": {
              "type": "integer",
              "minimum": 1,
              "description": "Maximum method complexity above which a type may be a god class."
            }
          }
        }
      }
    },
    "integrations": {
      "type": "object",
      "additionalProperties": false,
      "description": "Outbound integration detection of the .NET analyzer (022-external-integrations).",
      "properties": {
        "outbound": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "description": "auto = Visual Basic compilations only."
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "description": "External dependency and end-of-life detection of the .NET analyzer (022-external-integrations).",
      "properties": {
        "enabled": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ]
        },
        "eol": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Name prefixes added to schema/eol-dependencies.json."
        }
      }
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "description": "Inference-wide parameters and preset (023-legacy-desktop-inference).",
      "properties": {
        "preset": {
          "enum": [
            "auto",
            "none",
            "legacy-desktop"
          ],
          "description": "auto = legacy-desktop for Visual Basic graphs (meta.source roslyn-fallback or >= 50% .vb components); none = never."
        },
        "presentationInCohesion": {
          "type": "boolean",
          "description": "false = Layer:Presentación/Layer:Reportes members do not count in cohesion or internal density."
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "description": "Extended static analysis of the .NET analyzer (024-extended-static-analysis).",
      "properties": {
        "extended": {
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "description": "off by default (opt-in); auto = Visual Basic compilations only; on = every compilation."
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Official analyzer rule ids to evaluate; empty = the versioned list schema/extended-rules.json."
        },
        "duplicateMinTokens": {
          "type": "integer",
          "minimum": 10,
          "description": "Minimum normalized tokens of a duplicated method."
        },
        "sarif": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "SARIF 2.1.0 reports merged into code_issues (paths relative to the analyzed project)."
        },
        "layerSuppressions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^:]+:[^:]+$"
          },
          "description": "Layer:RULE entries removed for components of that fine layer."
        },
        "referenceAssemblies": {
          "type": [
            "string",
            "null"
          ],
          "description": "025: directory of .NET Framework reference assemblies (*.dll and Facades/*.dll) used by the VB Adhoc fallback instead of the host runtime assemblies; null = default."
        }
      }
    }
  }
}
