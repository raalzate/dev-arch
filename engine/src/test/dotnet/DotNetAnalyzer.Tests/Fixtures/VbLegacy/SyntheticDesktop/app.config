<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System">
      <section name="LegacyShop.My.MySettings" type="System.Configuration.ClientSettingsSection, System" requirePermission="false" />
    </sectionGroup>
  </configSections>
  <connectionStrings>
    <add name="ShopDb" connectionString="Data Source=db.example.invalid;Initial Catalog=Shop;User ID=shop_app;Password=Synthetic-Pass-123" providerName="System.Data.SqlClient" />
    <add name="ReportsDb" connectionString="Data Source=db.example.invalid;Initial Catalog=Reports;Integrated Security=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="ApiKey" value="Synthetic-ApiKey-0000" />
    <add key="ReportsFolder" value="C:\Reports" />
  </appSettings>
  <applicationSettings>
    <LegacyShop.My.MySettings>
      <setting name="UpdateServiceToken" serializeAs="String">
        <value>Synthetic-Token-9999</value>
      </setting>
    </LegacyShop.My.MySettings>
  </applicationSettings>
</configuration>
