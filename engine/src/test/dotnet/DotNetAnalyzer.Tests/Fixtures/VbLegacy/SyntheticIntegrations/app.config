<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="BisiBaseURL" value="https://bisi.example.invalid/api" />
  </appSettings>
  <system.serviceModel>
    <client>
      <endpoint address="net.tcp://ofac.example.invalid:8012/Ofac" binding="netTcpBinding" contract="Ofac.IOfacService" name="TcpEndpoint" />
    </client>
  </system.serviceModel>
</configuration>
