    Public Class PolicyFacade

        Private Shared _archivedCount As Integer = 0

        Public Shared Function ArchiveExpired() As Integer
            Dim n As Integer = _archivedCount
            If n = 0 Then n = n + 1
            If n = 1 Then n = n + 1
            If n = 2 Then n = n + 1
            If n = 3 Then n = n + 1
            If n = 4 Then n = n + 1
            If n = 5 Then n = n + 1
            If n = 6 Then n = n + 1
            If n = 7 Then n = n + 1
            If n = 8 Then n = n + 1
            If n = 9 Then n = n + 1
            If n = 10 Then n = n + 1
            If n = 11 Then n = n + 1
            If n = 12 Then n = n + 1
            If n = 13 Then n = n + 1
            If n = 14 Then n = n + 1
            If n = 15 Then n = n + 1
            Select Case n
                Case 1
                    n = n + 10
                Case 2
                    n = n + 20
            End Select
            _archivedCount = n
            Return n
        End Function

