<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs baseline (2026-10-07). CI fails on any finding NOT listed here.
  Ratchet: remove entries as they are fixed; never add new ones without review.
-->
<FindBugsFilter>
  <!-- Model/DTO classes intentionally expose mutable collections (Jackson-bound). -->
  <Match><Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/></Match>

  <Match><Class name="com.extractor.model.ApiSchema"/><Bug pattern="URF_UNREAD_FIELD"/></Match>
  <Match><Class name="com.extractor.utils.DependencyResolver"/><Method name="parseMavenPom"/><Bug pattern="SBSC_USE_STRINGBUFFER_CONCATENATION"/></Match>
</FindBugsFilter>
