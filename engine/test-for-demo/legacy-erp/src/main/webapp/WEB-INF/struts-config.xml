<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts-config PUBLIC
    "-//Apache Software Foundation//DTD Struts Configuration 1.3//EN"
    "http://struts.apache.org/dtds/struts-config_1_3.dtd">

<struts-config>
    <action-mappings>
        <action path="/orders"
                type="com.acme.erp.web.OrderAction"
                scope="request">
            <forward name="orderList" path="/WEB-INF/jsp/orders/list.jsp"/>
            <forward name="orderDetail" path="/WEB-INF/jsp/orders/detail.jsp"/>
            <forward name="error" path="/WEB-INF/jsp/error.jsp"/>
        </action>
    </action-mappings>

    <message-resources parameter="com.acme.erp.resources.ApplicationResources"/>
</struts-config>
