#!/usr/bin/env bash
# iikit scripts locate the project with `git rev-parse --show-toplevel`, which in the
# maestria-ia monorepo returns the monorepo root instead of apps/dev-arch.
# Put this directory first on PATH (see scripts/iikit-env.sh) to answer that one query
# with the product root; every other git invocation goes to the real git.
self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
product_root="$(cd "$self_dir/../.." && pwd)"
if [ "$#" -eq 2 ] && [ "$1" = "rev-parse" ] && [ "$2" = "--show-toplevel" ]; then
  echo "$product_root"
  exit 0
fi
IFS=: read -ra dirs <<< "$PATH"
for d in "${dirs[@]}"; do
  [ "$d" = "$self_dir" ] && continue
  [ -x "$d/git" ] && exec "$d/git" "$@"
done
echo "iikit-git-shim: real git not found on PATH" >&2
exit 127
