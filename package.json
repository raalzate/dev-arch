{
  "name": "dev-arch",
  "version": "1.2.0",
  "private": true,
  "description": "dev-arch product workspace: Next.js web and the Static Inference output contract package (006-devarch-monorepo).",
  "bin": {
    "dev-arch": "scripts/doctor/cli.mjs"
  },
  "workspaces": [
    "web",
    "schema"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test:acceptance": "NODE_OPTIONS=\"--import tsx\" cucumber-js",
    "test:e2e": "DEVARCH_E2E=true DEVARCH_E2E_BROWSER=true NODE_OPTIONS=\"--import tsx\" cucumber-js --tags @e2e",
    "doctor": "node scripts/doctor/cli.mjs"
  },
  "devDependencies": {
    "@cucumber/cucumber": "11.3.0",
    "picomatch": "4.0.7",
    "playwright": "1.64.0",
    "tsx": "4.23.15",
    "yaml": "2.9.1"
  }
}
