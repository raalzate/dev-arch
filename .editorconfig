# dev-arch product editor rules (web, engine, schema) — 006-devarch-monorepo, research D10.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{java,cs,vb,xml,csproj,vbproj,sln,props,targets}]
indent_size = 4

[*.{cmd,bat}]
end_of_line = crlf

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
